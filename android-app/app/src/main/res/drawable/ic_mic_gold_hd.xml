<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="36dp"
    android:height="36dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

  <!-- Microphone Capsule with Golden Yellow Gradient -->
  <path
      android:pathData="M8,4a4,4 0,0 1,8 0v7a4,4 0,0 1,-8 0z">
    <aapt:attr name="android:fillColor">
      <gradient
          android:type="linear"
          android:startX="8"
          android:startY="2"
          android:endX="16"
          android:endY="13">
        <item android:offset="0.0" android:color="#FDE68A" />
        <item android:offset="0.5" android:color="#F59E0B" />
        <item android:offset="1.0" android:color="#B45309" />
      </gradient>
    </aapt:attr>
  </path>

  <!-- Cradle Arc -->
  <path
      android:pathData="M4,10c0,4.42 3.58,8 8,8s8,-3.58 8,-8"
      android:strokeWidth="2.4"
      android:strokeColor="#F59E0B"
      android:strokeLineCap="round" />

  <!-- Center Pole -->
  <path
      android:pathData="M12,18v4"
      android:strokeWidth="2.4"
      android:strokeColor="#F59E0B"
      android:strokeLineCap="round" />

  <!-- Base Foot Plate -->
  <path
      android:pathData="M8,22h8"
      android:strokeWidth="2.4"
      android:strokeColor="#F59E0B"
      android:strokeLineCap="round" />
</vector>
