    <!-- High-Contrast Black Outline for Full Background Contrast -->
    <path
        android:pathData="M 12,3 L 12,21 M 3,12 L 21,12"
        android:strokeColor="#000000"
        android:strokeWidth="3.4"
        android:strokeLineCap="round" />

    <!-- Pure Crisp White Crosshair (+) Lines -->
