<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="145dp"
    android:orientation="vertical"
    android:background="@drawable/bg_glass_card_purple"
    android:padding="16dp"
    android:gravity="center_vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ivDriveIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_gem_purple"
            android:src="@drawable/ic_drive"
            android:padding="10dp"
            android:contentDescription="Drive" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvDriveBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="READY"
            android:textSize="9sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:textColor="#C084FC"
            android:background="#25C084FC"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvDriveName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Local Disk (C:)"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:fontFamily="@font/syne_extrabold"
        android:layout_marginTop="14dp" />

    <TextView
        android:id="@+id/tvDriveSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PC Storage Volume"
        android:textSize="11sp"
        android:textColor="#94A3B8"
        android:fontFamily="monospace"
        android:layout_marginTop="3dp" />

    <!-- Capacity Bar & Label -->
    <LinearLayout
        android:id="@+id/llDriveCapacity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="10dp">

        <ProgressBar
            android:id="@+id/pbDriveCapacity"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:max="100"
            android:progress="65"
            android:progressTint="#F59E0B"
            android:progressBackgroundTint="#334155" />

        <TextView
            android:id="@+id/tvDriveCapacity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="245 GB free of 476 GB"
            android:textSize="9.5sp"
            android:fontFamily="monospace"
            android:textColor="#94A3B8"
            android:layout_marginTop="4dp" />
    </LinearLayout>

</LinearLayout>
