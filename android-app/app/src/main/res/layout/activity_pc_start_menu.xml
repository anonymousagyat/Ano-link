<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayoutStartMenu"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#060911">

    <!-- Top Bar: Back Button | Strictly Centered Windows Logo & Start Menu Branding -->
    <!-- Top Bar: Back Button | Strictly Centered Windows Logo & Start Menu Branding -->
    <FrameLayout
        android:id="@+id/rlStartMenuHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <!-- Back Button -->
            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/bg_start_menu_tile"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="Back"
                android:padding="8dp" />

            <!-- Strictly Centered Header: Windows Logo + Start (White) Menu (Blue) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_win_logo"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="Windows Logo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Start"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:fontFamily="@font/syne_extrabold"
                    android:letterSpacing="0.02" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Menu"
                    android:textColor="#0078D4"
                    android:textSize="20sp"
                    android:fontFamily="@font/syne_extrabold"
                    android:layout_marginStart="6dp"
                    android:letterSpacing="0.02" />
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>

    <!-- Search Row with Integrated Grid / List View Toggle Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Sleek Search Input Box -->
        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_start_menu_search">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="14dp"
                android:src="@drawable/ic_search"
                android:contentDescription="Search Icon" />

            <EditText
                android:id="@+id/editSearchApp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="Search apps, tools, settings on PC..."
                android:textColorHint="#64748B"
                android:textColor="#FFFFFF"
                android:textSize="13.5sp"
                android:singleLine="true"
                android:paddingStart="44dp"
                android:paddingEnd="40dp"
                android:imeOptions="actionSearch" />

            <ImageView
                android:id="@+id/btnClearSearch"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="12dp"
                android:src="@drawable/ic_clear"
                android:contentDescription="Clear"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true" />
        </RelativeLayout>

        <!-- View Mode Toggle Button (Grid <-> List) -->
        <ImageButton
            android:id="@+id/btnToggleViewMode"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_start_menu_tile"
            android:src="@drawable/ic_view_list"
            android:padding="12dp"
            android:contentDescription="Toggle Grid or List View"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Unified Apps View: Shows ALL Installed PC Apps (Grid View Default, Switchable to List View) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerApps"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="24dp"
        android:clipToPadding="false"
        android:overScrollMode="never" />

</LinearLayout>
