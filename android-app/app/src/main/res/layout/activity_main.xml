<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootScrollMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_cyber_void"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/llMainContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="28dp"
        android:paddingBottom="24dp">

        <!-- ===================================================== -->
        <!-- BRAND HEADER: ANO-LINK IDENTITY + SETTINGS GEAR       -->
        <!-- ===================================================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="22dp">

            <!-- Custom Neural Logo -->
            <ImageView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:src="@drawable/ic_ano_logo"
                android:contentDescription="Ano-Link Neural Logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ano"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/syne_extrabold"
                        android:letterSpacing="-0.01"
                        android:textColor="#FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="link"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/syne_extrabold"
                        android:letterSpacing="-0.01"
                        android:textColor="#A855F7" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PRO"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#C084FC"
                        android:background="@drawable/bg_badge_violet"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="By Anonymous/अज्ञात"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#64748B"
                    android:letterSpacing="0.16"
                    android:layout_marginTop="3dp" />
            </LinearLayout>

            <!-- Settings Gear Button (Opens Settings Page) -->
            <ImageButton
                android:id="@+id/btnOpenSettings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_settings"
                android:scaleType="centerInside"
                android:background="@drawable/bg_rail_tile"
                android:contentDescription="Settings" />
        </LinearLayout>

        <!-- ===================================================== -->
        <!-- ===================================================== -->
        <!-- PC VIEWPORT DISPLAY CARD (5-MIN OLED SLIDESHOW)       -->
        <!-- ===================================================== -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardPcViewport"
            android:layout_width="match_parent"
            android:layout_height="224dp"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="22dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#0A0F1D"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- 1. Wallpaper Cross-Fade Layers -->
                <ImageView
                    android:id="@+id/ivWallpaperA"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="OLED Wallpaper Canvas" />

                <ImageView
                    android:id="@+id/ivWallpaperB"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:alpha="0"
                    android:contentDescription="OLED Wallpaper Canvas Preload" />

                <!-- 2. Cinematic Vignette (Subtle Dark Gradient for 100% legibility) -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_viewport_vignette" />

                <!-- 3. TOP HUD: Sleek Frosted Glass Status Capsule + Latency -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="14dp">

                    <!-- Luminous Status Capsule: [ (•) Live / ☁ Cloudflare ] -->
                    <LinearLayout
                        android:id="@+id/llViewportStatusCapsule"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:background="@drawable/bg_hud_capsule_glass"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp">

                        <!-- Pulsing Neon Emerald Jewel -->
                        <View
                            android:id="@+id/dotStatusJewel"
                            android:layout_width="7dp"
                            android:layout_height="7dp"
                            android:background="@drawable/bg_dot_emerald" />

                        <!-- Minimal Status Label -->
                        <TextView
                            android:id="@+id/tvViewportStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="Live"
                            android:textColor="#34D399"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvViewportDivider"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="6dp"
                            android:text="/"
                            android:textColor="#64748B"
                            android:textSize="11sp" />

                        <!-- Cloudflare Cloud Icon + Label -->
                        <ImageView
                            android:id="@+id/ivViewportCloudIcon"
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:src="@drawable/ic_cloudflare_cloud"
                            app:tint="#C4B5FD"
                            android:contentDescription="Cloudflare" />

                        <TextView
                            android:id="@+id/tvViewportTunnelBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="Cloudflare"
                            android:textColor="#C4B5FD"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Latency Micro-Pill -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:background="@drawable/bg_hud_capsule_glass"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="5dp">

                        <View
                            android:layout_width="5dp"
                            android:layout_height="5dp"
                            android:background="@drawable/bg_dot_emerald" />

                        <TextView
                            android:id="@+id/tvViewportLatency"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:fontFamily="monospace"
                            android:text="16ms"
                            android:textColor="#34D399"
                            android:textSize="10.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </RelativeLayout>

                <!-- 4. BOTTOM HUD: Workstation Identity + Tap Hint -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingBottom="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:background="@drawable/bg_badge_dot_purple"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="monospace"
                            android:letterSpacing="0.08"
                            android:text="PRIMARY WORKSTATION"
                            android:textColor="#C4B5FD"
                            android:textSize="9.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="Tap to open Remote Screen ➔"
                            android:textColor="#94A3B8"
                            android:textSize="9.5sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvPcName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/syne_extrabold"
                        android:letterSpacing="0.01"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:text="No PC Connected"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <!-- ===================================================== -->
        <!-- HUB FEATURES: PHONE CONTROLLING PC MODULES            -->
        <!-- ===================================================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="PC CONTROL'S"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:textColor="#94A3B8"
                android:letterSpacing="0.08" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4 ACTIVE"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:textColor="#60A5FA" />
        </LinearLayout>

        <!-- MODULE 1: REMOTE SCREEN (YELLOW THEME) -->
        <LinearLayout
            android:id="@+id/btnLaunchPcRemote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_card_amber"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="12dp">

            <ImageView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_gem_amber"
                android:src="@drawable/ic_monitor"
                app:tint="#F59E0B"
                android:padding="10dp"
                android:contentDescription="Remote Screen" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Remote Screen"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CONTROL"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:textColor="#03060D"
                        android:background="@drawable/bg_badge_yellow"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:singleLine="true"
                        android:maxLines="1"
                        android:layout_marginStart="14dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Access your pc"
                    android:textSize="12sp"
                    android:textColor="#94A3B8"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="#F59E0B"
                android:contentDescription="Open" />
        </LinearLayout>

        <!-- MODULE 2: PC FILE EXPLORER (ZARCHIVER STYLE) -->
        <LinearLayout
            android:id="@+id/btnLaunchPcFiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_card_purple"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="12dp">

            <ImageView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_gem_purple"
                android:src="@drawable/ic_folder_purple"
                android:padding="10dp"
                android:contentDescription="File Explorer" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="File Explorer"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FILES"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:textColor="#03060D"
                        android:background="@drawable/bg_badge_purple_solid"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:singleLine="true"
                        android:maxLines="1"
                        android:layout_marginStart="14dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Browse C:, D: drives, download files &amp; open directly"
                    android:textSize="12sp"
                    android:textColor="#94A3B8"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="#C084FC"
                android:contentDescription="Open" />
        </LinearLayout>

        <!-- MODULE 3: START MENU & SEARCH -->
        <LinearLayout
            android:id="@+id/btnHubStartMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_card_blue"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="12dp">

            <ImageView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_gem_blue"
                android:src="@drawable/ic_windows_logo"
                android:padding="11dp"
                android:contentDescription="Windows Menu" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Start Menu"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OPEN APPS"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/bg_badge_win_blue"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:singleLine="true"
                        android:maxLines="1"
                        android:layout_marginStart="14dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Toggle Windows Start menu &amp; search on PC"
                    android:textSize="12sp"
                    android:textColor="#94A3B8"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="#0078D4"
                android:contentDescription="Open" />
        </LinearLayout>

        <!-- MODULE 4: SYSTEM INFO (TASK MANAGER) -->
        <LinearLayout
            android:id="@+id/btnHubSystemInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_card_amber"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="24dp">

            <ImageView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_gem_amber"
                android:src="@drawable/ic_taskmgr_yellow"
                android:padding="11dp"
                android:contentDescription="Task Manager" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Task Manager"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HARDWARE"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:textColor="#03060D"
                        android:background="@drawable/bg_badge_yellow"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:singleLine="true"
                        android:maxLines="1"
                        android:layout_marginStart="14dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Live CPU, Memory, Disk, Wi-Fi graphs &amp; PC telemetry"
                    android:textSize="12sp"
                    android:textColor="#94A3B8"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="#F59E0B"
                android:contentDescription="Open" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
